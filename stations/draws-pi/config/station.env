# DRAWS station settings, installed as /etc/draws-station/station.env.
# Read by bin/draws-ptt, bin/draws-txwav, bin/draws-rxrec and the systemd units.

# Which DRAWS port the radio is cabled to: left or right.
# Found at the bench: sudo draws-findport --write /etc/draws-station/station.env
DRAWS_PORT=left

# PTT GPIO (BCM numbers). Left port = 12, right port = 23.
PTT_GPIO_LEFT=12
PTT_GPIO_RIGHT=23

# Delay after keying before audio starts, and after audio before unkeying (ms).
# The radio's TX relay needs a moment; 150 ms is a safe start.
PTT_LEAD_MS=150
PTT_TAIL_MS=100

# Hard limit on one transmission (seconds). draws-txwav refuses longer WAVs
# and cuts PTT at this time whatever happens.
TX_MAX_SECONDS=120

# Keying is off until this file exists. Alex creates it by hand.
TX_ENABLE_FILE=/etc/draws-station/tx-enabled

# ALSA devices from alsa/asound.conf.
TX_PCM_LEFT=draws_left_tx
TX_PCM_RIGHT=draws_right_tx
RX_PCM=draws_rx

# Spool folders. Audio here is temporary; it belongs on the data store.
TX_SPOOL=/var/spool/draws-station/tx
RX_SPOOL=/var/spool/draws-station/rx

# Length of one receive file (seconds).
RX_FILE_SECONDS=600

# CAT: Hamlib model of the radio on the DRAWS (Hamlib 4.5: rigctl -l | grep FT-8).
# 1020 FT-817, 1041 FT-818, 1022 FT-857, 1023 FT-897, 1043 FT-897D.
# 1022 is the worked example (FT-857D); change it to match the radio.
RIG_MODEL=1022
# The CAT port is not assumed. Found at the bench, on any USB port:
#   sudo draws-findcat --write /etc/draws-station/station.env
# which writes the /dev/serial/by-id/... name of the port that answered.
RIG_DEVICE=/dev/serial/by-id/FOUND-AT-THE-BENCH-BY-DRAWS-FINDCAT
# Must match the radio's CAT RATE menu. draws-findcat probes at this rate only.
RIG_BAUD=38400
