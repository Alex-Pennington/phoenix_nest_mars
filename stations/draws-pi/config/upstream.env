# Settings for the upstream host's side of the DRAWS station: bin/draws-send
# and bin/draws-pull. The upstream host is munin today and Har later.
# Installed on the upstream host as ~/.config/draws-station/upstream.env
# (or point DRAWS_UPSTREAM_ENV at another copy). Nothing here keys the radio:
# keying is decided on the Pi only.

# The Pi, as ssh from the upstream host reaches it: [user@]host.
# ssh must log in with a key and no prompt (the helpers use BatchMode).
# Defaults: how munin logged in to the Pi on 2026-11-28, by address, as
# rayven, with munin's key file ~/.ssh/root. munin's known_hosts holds the
# Pi's host key under the name draws1, hence HostKeyAlias. No secret is kept
# here: only the path of the key file.
DRAWS_PI_HOST=rayven@192.168.5.216
# Extra ssh options, split on spaces (no spaces inside a value).
DRAWS_PI_SSH_OPTS="-i $HOME/.ssh/root -o HostKeyAlias=draws1"

# Paths on the Pi, as the checklist's install block makes them.
PI_TX_SPOOL=/var/spool/draws-station/tx
PI_RX_SPOOL=/var/spool/draws-station/rx
PI_TXWAV=/usr/local/bin/draws-txwav

# Where draws-pull puts the Pi's recordings on the upstream host.
LOCAL_RX_DIR="$HOME/draws-station/rx"
