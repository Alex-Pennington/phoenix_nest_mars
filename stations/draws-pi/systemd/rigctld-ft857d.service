[Unit]
Description=Hamlib rigctld for the FT-857D (CAT only, localhost)
After=network.target draws-ptt-safe.service
Wants=draws-ptt-safe.service

[Service]
EnvironmentFile=/etc/draws-station/station.env
User=draws
Group=dialout
# Frequency and mode only. PTT is the DRAWS hardware line, never CAT or VOX here.
ExecStart=/usr/bin/rigctld -m ${RIG_MODEL} -r ${RIG_DEVICE} -s ${RIG_BAUD} -T 127.0.0.1 -t 4532
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
