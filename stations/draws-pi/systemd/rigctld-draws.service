[Unit]
Description=Hamlib rigctld for the radio on the DRAWS (CAT only, localhost)
After=network.target draws-ptt-safe.service
Wants=draws-ptt-safe.service

[Service]
EnvironmentFile=/etc/draws-station/station.env
User=draws
Group=dialout
# Frequency and mode only. -P NONE: rigctld has no PTT, so CAT cannot key.
# Keying is the DRAWS hardware PTT line only, never CAT, never VOX.
# cache_timeout=0: every read asks the radio, so draws-setfreq's read-back is
# the radio's and not Hamlib's cache (Hamlib 4.5.5 src/rig.c:623).
# rts_state=OFF, dtr_state=OFF: Hamlib lowers both lines straight after it
# opens the port (src/iofunc.c:258-283). Left unset, they stay where the
# kernel raised them at open for as long as rigctld runs (src/serial.c:292-296
# is commented out), and after it exits too, since Hamlib clears HUPCL
# (src/serial.c:410). The kernel's raise at open itself cannot be avoided.
ExecStart=/usr/bin/rigctld -m ${RIG_MODEL} -r ${RIG_DEVICE} -s ${RIG_BAUD} -P NONE -C cache_timeout=0,rts_state=OFF,dtr_state=OFF -T 127.0.0.1 -t 4532
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
